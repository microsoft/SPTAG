{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure Debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}", "-B", "${workspaceFolder}/build",
                "-DCMAKE_BUILD_TYPE=Debug", "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
                "-DFOLLY=OFF", "-DTBB=ON", "-DSPDK=OFF", "-DROCKSDB=OFF",
                "-DTIKV=OFF", "-DGPU=OFF", "-DRABITQ=OFF"
            ],
            "windows": {
                "args": [
                    "-S", "${workspaceFolder}", "-B", "${workspaceFolder}/build",
                    "-A", "x64", "-DCMAKE_BUILD_TYPE=Debug",
                    "-DFOLLY=OFF", "-DTBB=OFF", "-DSPDK=OFF", "-DROCKSDB=OFF",
                    "-DTIKV=OFF", "-DGPU=OFF", "-DRABITQ=OFF"
                ]
            },
            "problemMatcher": []
        },
        {
            "label": "Build Debug",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/build", "--config", "Debug", "--target", "SPTAGTest", "--parallel", "2"],
            "dependsOn": "Configure Debug",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "windows": {
                "problemMatcher": ["$msCompile"]
            }
        }
    ]
}
