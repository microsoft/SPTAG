{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Linux: baseline helper tests (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "Build Debug",
            "program": "${workspaceFolder}/Debug/SPTAGTest",
            "args": ["--run_test=CommonHelperTest:IniReaderTest:ConcurrentHashMapTest"],
            "cwd": "${workspaceFolder}/Debug",
            "MIMode": "gdb",
            "stopAtEntry": false,
            "externalConsole": false
        },
        {
            "name": "Windows: baseline helper tests",
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "Build Debug",
            "program": "${workspaceFolder}/build/Debug/SPTAGTest.exe",
            "args": ["--run_test=CommonHelperTest:IniReaderTest:ConcurrentHashMapTest"],
            "cwd": "${workspaceFolder}/build/Debug",
            "stopAtEntry": false
        }
    ]
}
